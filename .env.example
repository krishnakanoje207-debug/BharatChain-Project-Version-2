# ============================================================================
# BharatChain — environment template. Copy to .env and fill in.
# Everything here is free/local by default. Do NOT commit a real .env.
# ============================================================================

# ----- Runtime -----
NODE_ENV=development

# ----- Backend API -----
# Hosted platforms (Render) inject PORT, which wins over BACKEND_PORT.
BACKEND_PORT=3001
# Comma-separated origins allowed to call the API (the unified portal runs on :3000)
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-dev-only
# Demo admin account created by the seeder (admin/RBI-only endpoints)
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=admin12345
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
# Session heartbeat: server invalidates this long after heartbeats stop (auto-logout)
SESSION_HEARTBEAT_TIMEOUT_SECONDS=60

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=bharat
POSTGRES_PASSWORD=bharat
POSTGRES_DB=bharatchain
# DATABASE_URL wins over the discrete vars above; append ?sslmode=require for
# hosted Postgres (Neon). DB_SYNCHRONIZE=true forces schema sync even under
# NODE_ENV=production (prototype has no migrations — hosted deploys need it).
DATABASE_URL=postgresql://bharat:bharat@localhost:5432/bharatchain
#DB_SYNCHRONIZE=true

# ----- Redis (sessions, OTP, rate-limit) -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ----- Kafka (event bus / ETL / anomaly detection) -----
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=bharatchain
# Fraud/anomaly detection thresholds (Kafka-fed; surfaced to admin/RBI):
# fan-in = one vendor paid by this many DISTINCT citizens within the window
ANOMALY_FANIN_THRESHOLD=3
ANOMALY_FANIN_WINDOW_MIN=60
# velocity = this many payments to one vendor within the window
ANOMALY_VELOCITY_THRESHOLD=5
ANOMALY_VELOCITY_WINDOW_SEC=120

# ----- The Graph (self-hosted Graph Node) -----
GRAPH_NODE_URL=http://localhost:8000
GRAPH_NODE_ADMIN_URL=http://localhost:8020
IPFS_URL=http://localhost:5001

# ----- MinIO (document storage, S3-compatible) -----
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bharatchain-docs
MINIO_USE_SSL=false

# ----- Blockchain -----
# Local dev defaults to the Hardhat node
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Which deployments/<network>.json the backend loads (addresses + ABIs)
CHAIN_NETWORK=localhost
# Server-side relayer key (the ONLY operational signer; users hold no keys).
# Local Hardhat account #0 default key — replace for any testnet use.
RELAYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Testnet (free): pick one. Get RPC + faucet funds (free).
AMOY_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
# Optional: deploy/verify keys (free testnet only)
ETHERSCAN_API_KEY=

# ----- Chainlink Automation (testnet) / cron fallback (local) -----
USE_CHAINLINK_AUTOMATION=false
CRON_DISBURSAL_ENABLED=true
# node-cron schedule for auto-disbursal rounds (5-field, or 6-field with seconds)
CRON_DISBURSAL_SCHEDULE=*/2 * * * *

# ----- Email (REAL — free) -----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BharatChain <no-reply@bharatchain.local>"

# ----- SMS / OTP (SIMULATED — shown in-app/console/DB) -----
SMS_PROVIDER=simulated

# ----- AI assistant (free tiers / local) -----
BHASHINI_USER_ID=
BHASHINI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=http://localhost:11434
# Ollama model name — the sovereign model from ai-model/ (Modelfile or QLoRA export),
# or any pulled base model (e.g. llama3.2:3b).
OLLAMA_MODEL=bharatchain-assistant
