# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

# Hardhat / contracts
artifacts/
cache/
typechain-types/
coverage/
coverage.json
deployments/

# Circom / ZK artifacts (large; generated)
*.zkey
*.r1cs
*.wasm
*.ptau
packages/circuits/build/

# Env & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Docker / data volumes
infra/data/

# Claude Code local (personal) settings
.claude/settings.local.json

# Misc
tmp/
.temp/

# Local working files - never publish (prompts, briefs, stray captures, tool state)
*.docx
*.pptx
*.doc
*.xlsx
Screenshot*.png
.design-sync/
graphify-out/
.claude/

# Internal dev logs - kept locally, not published
docs/DECISIONS.md
docs/GAP_ANALYSIS.md

# ZK artifacts: runtime prover files ARE shipped (needed by the deployed backend);
# everything else stays generated-only. (Parent dirs must be re-included first —
# git never descends into a fully-ignored directory.)
!packages/circuits/build/
packages/circuits/build/*
!packages/circuits/build/eligibility_final.zkey
!packages/circuits/build/vendorEligibility_final.zkey
!packages/circuits/build/verification_key.json
!packages/circuits/build/eligibility_js/
packages/circuits/build/eligibility_js/*
!packages/circuits/build/eligibility_js/eligibility.wasm
!packages/circuits/build/vendorEligibility_js/
packages/circuits/build/vendorEligibility_js/*
!packages/circuits/build/vendorEligibility_js/vendorEligibility.wasm

# Testnet deployment record (addresses + ABIs) IS shipped — the hosted backend
# reads it via CHAIN_NETWORK=amoy. Local/other networks stay ignored.
!packages/contracts/deployments/
packages/contracts/deployments/*
!packages/contracts/deployments/amoy.json
