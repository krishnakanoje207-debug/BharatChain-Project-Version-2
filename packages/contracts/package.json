{
  "name": "@bharatchain/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "BharatChain smart contracts (Solidity + Hardhat)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "deploy:arbitrum": "hardhat run scripts/deploy.ts --network arbitrumSepolia",
    "lint": "solhint \"contracts/**/*.sol\"",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/merkle-tree": "^1.0.7",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0",
    "solhint": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0"
  }
}
